# Database
DATABASE_URL=sqlite:///./sponsybot.db

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Models (Gemini - free tier available)
GEMINI_API_KEY=your-gemini-api-key

# Research API (Tavily - free tier available)
TAVILY_API_KEY=your-tavily-api-key

# Contact Search (Apollo or Hunter - free tier available)
APOLLO_API_KEY=your-apollo-api-key
HUNTER_API_KEY=your-hunter-api-key

# Email (SMTP - Gmail or other)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Demo Mode (set to true to use mock data when APIs unavailable)
DEMO_MODE=true